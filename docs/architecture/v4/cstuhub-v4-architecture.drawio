="geometry" x="0.0" y="158" width="350" height="120" /></mxCell><mxCell id="sns" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#DDE4EA;container=1;dropTarget=1;collapsible=0;" vertex="1" parent="ops"><mxGeometry as="geometry" x="1009.0" y="95" width="350" height="280" /></mxCell><mxCell id="snsglyph" value="" style="sketch=0;html=1;aspect=fixed;outlineConnect=0;strokeColor=#ffffff;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;fontSize=12;" vertex="1" parent="sns"><mxGeometry as="geometry" x="136.0" y="15" width="78" height="78" /></mxCell><mxCell id="snstitle" value="Amazon SNS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="sns"><mxGeometry as="geometry" x="0.0" y="108" width="350" height="48" /></mxCell><mxCell id="snssub" value="CSTUHub-System-Alerts&lt;br&gt;Standard topic [AUDIT]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=16;fontColor=#26374B;fontStyle=0;" vertex="1" parent="sns"><mxGeometry as="geometry" x="0.0" y="158" width="350" height="120" /></mxCell><mxCell id="email" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#DDE4EA;container=1;dropTarget=1;collapsible=0;" vertex="1" parent="ops"><mxGeometry as="geometry" x="1524.0" y="95" width="350" height="280" /></mxCell><mxCell id="emailglyph" value="" style="sketch=0;html=1;aspect=fixed;outlineConnect=0;strokeColor=none;fillColor=#34465D;shape=mxgraph.aws4.email_2;fontSize=12;" vertex="1" parent="email"><mxGeometry as="geometry" x="136.0" y="15" width="78" height="78" /></mxCell><mxCell id="emailtitle" value="Team email" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="email"><mxGeometry as="geometry" x="0.0" y="108" width="350" height="48" /></mxCell><mxCell id="emailsub" value="1 subscription Confirmed [AUDIT]&lt;br&gt;Human diagnosis / recovery" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=16;fontColor=#26374B;fontStyle=0;" vertex="1" parent="email"><mxGeometry as="geometry" x="0.0" y="158" width="350" height="120" /></mxCell><mxCell id="M1" value="&lt;b&gt;M1&lt;/b&gt; · Metrics / logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.2;strokeColor=#8B597E;startArrow=none;endArrow=block;startFill=1;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=16;fontFamily=Arial;fontColor=#8B597E;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="telemetry" target="cw"><mxGeometry as="geometry" relative="1" x="0" /></mxCell><mxCell id="M2" value="&lt;b&gt;M2&lt;/b&gt; · ALARM / OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.2;strokeColor=#8B597E;startArrow=none;endArrow=block;startFill=1;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=16;fontFamily=Arial;fontColor=#8B597E;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="cw" target="sns"><mxGeometry as="geometry" relative="1" x="0" /></mxCell><mxCell id="M3" value="&lt;b&gt;M3&lt;/b&gt; · Email" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.2;strokeColor=#8B597E;startArrow=none;endArrow=block;startFill=1;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=16;fontFamily=Arial;fontColor=#8B597E;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="sns" target="email"><mxGeometry as="geometry" relative="1" x="0" /></mxCell><mxCell id="monlimitst" value="OBSERVABILITY LIMITS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="ops"><mxGeometry as="geometry" x="40" y="400" width="1980" height="32" /></mxCell><mxCell id="monlimitsb" value="API-5xx ≥ 3 / 5 min; Auth-Errors ≥ 1 / 5 min [AUDIT].&lt;br&gt;Other alarms: API SlowResponses + 4 Lambda Errors/Throttles (10 total).&lt;br&gt;OK at audit time does not prove end-to-end availability.&lt;br&gt;No Singapore Synthetics canary [AUDIT] • email delivery not tested." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="ops"><mxGeometry as="geometry" x="40" y="438" width="1980" height="152" /></mxCell><mxCell id="delivery" value="04  /  SOURCE, BUILD &amp; DEPLOYMENT — ไม่ใช่ request path ของผู้ใช้" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#667D94;strokeWidth=1.5;dashed=0;container=1;dropTarget=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingTop=15;spacingLeft=20;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#667D94;" vertex="1" parent="1"><mxGeometry as="geometry" x="2160" y="3110" width="1990" height="610" /></mxCell><mxCell id="git" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#DDE4EA;container=1;dropTarget=1;collapsible=0;" vertex="1" parent="delivery"><mxGeometry as="geometry" x="24.0" y="95" width="390" height="280" /></mxCell><mxCell id="gitglyph" value="" style="sketch=0;html=1;aspect=fixed;outlineConnect=0;strokeColor=none;fillColor=#34465D;shape=mxgraph.aws4.source_code;fontSize=12;" vertex="1" parent="git"><mxGeometry as="geometry" x="156.0" y="15" width="78" height="78" /></mxCell><mxCell id="gittitle" value="GitHub · main" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="git"><mxGeometry as="geometry" x="0.0" y="108" width="390" height="48" /></mxCell><mxCell id="gitsub" value="Micosz/Cs361-Group1-Project7&lt;br&gt;Front-end source [LIVE linked repo]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=16;fontColor=#26374B;fontStyle=0;" vertex="1" parent="git"><mxGeometry as="geometry" x="0.0" y="158" width="390" height="120" /></mxCell><mxCell id="deployamp" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#DDE4EA;container=1;dropTarget=1;collapsible=0;" vertex="1" parent="delivery"><mxGeometry as="geometry" x="674.0" y="95" width="390" height="280" /></mxCell><mxCell id="deployampglyph" value="" style="sketch=0;html=1;aspect=fixed;outlineConnect=0;strokeColor=#ffffff;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.amplify;fontSize=12;" vertex="1" parent="deployamp"><mxGeometry as="geometry" x="156.0" y="15" width="78" height="78" /></mxCell><mxCell id="deployamptitle" value="Amplify build &amp; hosting" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="deployamp"><mxGeometry as="geometry" x="0.0" y="108" width="390" height="48" /></mxCell><mxCell id="deployampsub" value="amplify.yml → npm run build&lt;br&gt;Publishes public/ [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=16;fontColor=#26374B;fontStyle=0;" vertex="1" parent="deployamp"><mxGeometry as="geometry" x="0.0" y="158" width="390" height="120" /></mxCell><mxCell id="C1" value="&lt;b&gt;C1&lt;/b&gt; · Commit / build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.2;strokeColor=#667D94;startArrow=block;endArrow=block;startFill=1;endFill=1;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=16;fontFamily=Arial;fontColor=#667D94;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="git" target="deployamp"><mxGeometry as="geometry" relative="1" x="0" /></mxCell><mxCell id="actions" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;Auth package / deploy workflow [CODE]" style="rounded=1;fillColor=#FFFFFF;strokeColor=#94A3B8;html=1;whiteSpace=wrap;fontSize=18;" vertex="1" parent="delivery"><mxGeometry as="geometry" x="90" y="410" width="330" height="95" /></mxCell><mxCell id="iam" value="&lt;b&gt;IAM OIDC role&lt;/b&gt;&lt;br&gt;CSTUHubGitHubAuthDeployRole" style="rounded=1;fillColor=#FFFFFF;strokeColor=#94A3B8;html=1;whiteSpace=wrap;fontSize=18;" vertex="1" parent="delivery"><mxGeometry as="geometry" x="710" y="410" width="390" height="95" /></mxCell><mxCell id="C2" value="&lt;b&gt;C2&lt;/b&gt; · OIDC / credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.2;strokeColor=#667D94;startArrow=block;endArrow=block;startFill=1;endFill=1;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=16;fontFamily=Arial;fontColor=#667D94;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="actions" target="iam"><mxGeometry as="geometry" relative="1" x="0" /></mxCell><mxCell id="actionsref" value="&lt;b&gt;Actions [reference]&lt;/b&gt;" style="rounded=1;fillColor=#FFFFFF;strokeColor=#94A3B8;html=1;whiteSpace=wrap;fontSize=18;" vertex="1" parent="delivery"><mxGeometry as="geometry" x="90" y="530" width="330" height="55" /></mxCell><mxCell id="authdeploy" value="&lt;b&gt;CSTUHubAuth [reference]&lt;/b&gt;" style="rounded=1;fillColor=#FFFFFF;strokeColor=#94A3B8;html=1;whiteSpace=wrap;fontSize=18;" vertex="1" parent="delivery"><mxGeometry as="geometry" x="1370" y="530" width="520" height="55" /></mxCell><mxCell id="C3" value="&lt;b&gt;C3&lt;/b&gt; · Deploy / verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.2;strokeColor=#667D94;startArrow=block;endArrow=block;startFill=1;endFill=1;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#F5F5F5;fontSize=16;fontFamily=Arial;fontColor=#667D94;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="actionsref" target="authdeploy"><mxGeometry as="geometry" relative="1" x="0" /></mxCell><mxCell id="decisions" value="05  /  AVAILABILITY, SECURITY &amp; NETWORK DECISIONS — คำอธิบายสำหรับนำเสนอ" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#687E91;strokeWidth=1.5;dashed=0;container=1;dropTarget=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingTop=15;spacingLeft=20;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#687E91;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="3790" width="4100" height="730" /></mxCell><mxCell id="hat" value="AVAILABILITY ≠ BACKUP" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="decisions"><mxGeometry as="geometry" x="40" y="60" width="930" height="32" /></mxCell><mxCell id="hab" value="AWS-managed resilience [AWS docs]&lt;br&gt;• Lambda runs across multiple AZs.&lt;br&gt;• DynamoDB มีการทำสำเนาข้อมูลข้าม AZ โดย AWS.&lt;br&gt;• S3 Standard กระจายข้อมูลอย่างน้อย 3 AZ.&lt;br&gt;ไม่วาด Lambda 3 ตัวหรือ subnet สมมติแทนบริการ managed.&lt;br&gt;&lt;br&gt;PITR 35 วันทั้ง 6 ตาราง [AUDIT]&lt;br&gt;เปิด 29 ต.ค.; หน้าต่างย้อนหลังเพิ่มตามเวลาที่เปิด.&lt;br&gt;Restore สร้างตารางใหม่ ไม่แทนที่ตารางเดิมทันที.&lt;br&gt;ต้องปรับ environment / IAM / metadata แล้วตรวจระบบ.&lt;br&gt;&lt;br&gt;ไม่มี automatic cross-Region failover ในภาพนี้.&lt;br&gt;RTO / RPO ของแอปยังไม่ได้วัด." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="decisions"><mxGeometry as="geometry" x="40" y="98" width="930" height="532" /></mxCell><mxCell id="securityt" value="SECURITY / TRUST BOUNDARIES" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="decisions"><mxGeometry as="geometry" x="1060" y="60" width="930" height="32" /></mxCell><mxCell id="securityb" value="Browser → app: HTTPS + opaque session [CODE]&lt;br&gt;Secure / HttpOnly / SameSite=Lax; idle 30m / max 8h.&lt;br&gt;Backend: role / scope / parent / participant checks;&lt;br&gt;UI hiding is not authorization. Public fields filtered.&lt;br&gt;&lt;br&gt;AWS: execution role จำกัด resource/action;&lt;br&gt;DynamoDB ConditionCheck + app version checks.&lt;br&gt;S3: private bucket + TLS-only + CORS origin [CODE]&lt;br&gt;CORS is not authentication; signed URL is a temporary grant.&lt;br&gt;Replication role trusts S3, limited ready prefixes [AUDIT].&lt;br&gt;&lt;br&gt;SCP เปิด Singapore เฉพาะบัญชีเว็บ [deployment note].&lt;br&gt;SCP ไม่ให้สิทธิ์เว็บ user และไม่แทน IAM allow.&lt;br&gt;File checks ≠ antivirus • no full malware scanner verified." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="decisions"><mxGeometry as="geometry" x="1060" y="98" width="930" height="532" /></mxCell><mxCell id="scalet" value="SCALE / COST / BOTTLENECKS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="decisions"><mxGeometry as="geometry" x="2080" y="60" width="930" height="32" /></mxCell><mxCell id="scaleb" value="DynamoDB: On-demand [AUDIT]&lt;br&gt;Lambda Auth: shared unreserved pool 400;&lt;br&gt;provisioned concurrency 0 [AUDIT] (ไม่ใช่ 400 users).&lt;br&gt;API account: rate 10,000/s, burst 5,000 [AUDIT];&lt;br&gt;stage custom throttle not configured; limits ≠ benchmark.&lt;br&gt;&lt;br&gt;Public catalog scans whole Partner table [CODE].&lt;br&gt;Data growth increases read work / latency / cost.&lt;br&gt;Direct S3 upload avoids proxying file payload via API.&lt;br&gt;&lt;br&gt;Cache tuning อยู่แผน V6, ไม่วาด Redis/DAX ที่ยังไม่มี.&lt;br&gt;Load test, p95 latency, throughput ยังไม่ทำตามที่ตกลง.&lt;br&gt;ไม่อ้างว่ารองรับจำนวนผู้ใช้พร้อมกันที่ยังไม่ได้วัด." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="decisions"><mxGeometry as="geometry" x="2080" y="98" width="930" height="532" /></mxCell><mxCell id="recovert" value="RECOVERY / OUTSIDE THE ACTIVE FLOW" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="decisions"><mxGeometry as="geometry" x="3100" y="60" width="930" height="32" /></mxCell><mxCell id="recoverb" value="S3 versioning กู้รุ่นเดิม / delete marker ได้;&lt;br&gt;lifecycle จำกัดอายุบางรุ่น จึงไม่ใช่เก็บทุกอย่างตลอดไป.&lt;br&gt;Same-Region backup มีค่า storage + requests เพิ่ม;&lt;br&gt;ไม่มี lifecycle ลบ backup ใหม่ที่ยืนยัน [AUDIT].&lt;br&gt;Same account/Region ไม่แยกเหตุภัยระดับ Region/account.&lt;br&gt;&lt;br&gt;VPC CSTUHub-VPC มีอยู่ [AUDIT]; Auth ไม่ได้เชื่อม [LIVE].&lt;br&gt;ไม่มีเหตุผลวาด NAT, EC2, ALB หรือ public/private subnets.&lt;br&gt;ยังไม่ยืนยัน VPC config ของอีก 3 Lambda ในรอบนี้.&lt;br&gt;&lt;br&gt;Sydney เป็นประวัติ migration / rollback inventory ที่ต้องตรวจ;&lt;br&gt;ไม่ใช่ standby ล่าสุด: สลับ URL กลับอย่างเดียวอาจเสียข้อมูล.&lt;br&gt;Restore ทั้งแอป / backup mapping ยังไม่ได้ทดลอง." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="decisions"><mxGeometry as="geometry" x="3100" y="98" width="930" height="532" /></mxCell><mxCell id="presentation" value="Flow นำเสนอ: A1 → A2 → A3 → U1 → U3 → U4 → U5 แล้วแยกไป U7 (commit metadata) และ U6 (replication อัตโนมัติจาก S3) • ดาวน์โหลด U1 → U8" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=19;fontColor=#215C72;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="4535" width="4070" height="45" /></mxCell><mxCell id="sources" value="ฐานหลักฐาน: Services Detail.md (Console audit 29 Oct 2026); live Amplify rewrites/firewall, API integrations, Auth config; ADR V1/V2/V3; v4-deployment.md; backend/ + private/s3/ (local base 5be4a0b, deployed code parity not proved)." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=15;fontColor=#26374B;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="4590" width="4070" height="38" /></mxCell><mxCell id="sources2" value="AWS references: Lambda security-resilience • S3 DataDurability / replication-what-is-isnot-replicated • Amplify amplify-waf-configuration • DynamoDB point-in-time recovery.  รายละเอียดโค้ด [CODE] ไม่เท่ากับผลทดสอบ production ทุกเส้นทาง" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=15;fontColor=#26374B;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="4630" width="4070" height="34" /></mxCell><mxCell id="flowlegend" value="06  /  FLOW REGISTER — อธิบายข้อมูลทุกเส้นในภาพ" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#687E91;strokeWidth=1.5;dashed=0;container=1;dropTarget=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingTop=15;spacingLeft=20;fontFamily=Arial;fontSize=20;fontStyle=1;fontColor=#687E91;" vertex="1" parent="1"><mxGeometry as="geometry" x="4210" y="165" width="1440" height="4355" /></mxCell><mxCell id="flowintro" value="↔ คือคำขอและคำตอบของคู่บริการนั้น • ไม่ใช่ทำสำเนาข้อมูลสองทาง&lt;br&gt;→ เส้นประ คือเหตุการณ์ / ส่งข้อมูลทางเดียว • G1 คือความสัมพันธ์การควบคุม&lt;br&gt;ไอคอน [reference] เป็นบริการเดิมที่แสดงซ้ำ ไม่ได้สร้าง resource เพิ่ม" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=19;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="60" width="1360" height="110" /></mxCell><mxCell id="flow-G1title" value="G1  /  ACL" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="200" width="1350" height="32" /></mxCell><mxCell id="flow-G1body" value="WAF ผูกกับ Amplify delivery เพื่อประเมิน request ที่เข้าทางเว็บก่อนอนุญาตหรือบล็อก เส้นนี้เป็น association ไม่ใช่ proxy แยกเครื่อง ตรวจ Enabled แล้ว แต่ยังไม่ได้ตรวจทุก rule; ไม่เหมารวมว่า WAF ครอบคลุม execute-api โดยตรง" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="236" width="1350" height="100" /></mxCell><mxCell id="flow-A1title" value="A1  /  HTTPS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="343" width="1350" height="32" /></mxCell><mxCell id="flow-A1body" value="Browser ส่ง HTTPS ขอหน้าเว็บ / assets หรือเรียก API บน origin เดียวกัน; กลับเป็น HTML, CSS, JavaScript หรือ HTTP response ของ API รวม cookie จาก Auth ผ่านทางเดิม ผู้เยี่ยมชมไม่ถือ AWS credentials" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="379" width="1350" height="100" /></mxCell><mxCell id="flow-A2title" value="A2  /  Rewrite" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="486" width="1350" height="32" /></mxCell><mxCell id="flow-A2body" value="Amplify rewrite /api/&lt;*&gt; → API /default/api/&lt;*&gt; และ /fetchPartnersData → /default/fetchPartnersData (200 rewrite) จากนั้นส่ง status, headers และ body กลับ browser; ไม่ใช่ redirect ให้ browser ย้าย origin" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="522" width="1350" height="100" /></mxCell><mxCell id="flow-A3title" value="A3  /  Invoke" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="629" width="1350" height="32" /></mxCell><mxCell id="flow-A3body" value="ANY /api/{proxy+} ส่ง Lambda event แบบ payload 2.0 ให้ CSTUHubAuth; กลับเป็น statusCode / headers / body / Set-Cookie หรือ 302 ตาม route. Integration timeout 25 s; การตรวจสิทธิ์เป็นงาน backend" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="665" width="1350" height="100" /></mxCell><mxCell id="flow-A4title" value="A4  /  SDK / transaction" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="772" width="1350" height="32" /></mxCell><mxCell id="flow-A4body" value="Auth ใช้ AWS SDK อ่าน/เขียน Partner และ Business แล้วรับ rows หรือ transaction result กลับ. เก็บกิจกรรม ข้อตกลง การแลกเปลี่ยน feedback ประวัติ และ metadata เอกสาร; ตรวจ version / ConditionCheck ตามงาน [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="808" width="1350" height="100" /></mxCell><mxCell id="flow-A5title" value="A5  /  Session / identity" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="915" width="1350" height="32" /></mxCell><mxCell id="flow-A5body" value="Auth อ่าน/อัปเดต Users, IdentityLinks, Sessions, LoginRate เพื่อระบุตัวตน โหลดสิทธิ์ ตรวจอายุ session และจำกัด login. Browser เก็บ opaque cookie __Host-cstuhub; ไม่ได้อ่าน DynamoDB เอง [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="951" width="1350" height="100" /></mxCell><mxCell id="flow-A6title" value="A6  /  TU invoke" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1058" width="1350" height="32" /></mxCell><mxCell id="flow-A6body" value="ตอน TU login: CSTUHubAuth เรียก Lambda tuAuthLogin แบบ synchronous ด้วย credentials ที่รับมา; กลับเป็นผลตรวจตัวตน / profile หรือ error ก่อนผูกบัญชีและออก session. ไม่บันทึกรหัสผ่านใน diagram หรือ logs [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1094" width="1350" height="100" /></mxCell><mxCell id="flow-A7title" value="A7  /  TU HTTPS" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1201" width="1350" height="32" /></mxCell><mxCell id="flow-A7body" value="tuAuthLogin ส่ง HTTPS ไป TU authentication API ภายนอก AWS แล้วรับ profile หรือผลล้มเหลว. TU เป็น dependency ของการ login; ไม่ได้หมายความว่าทุกคำขออ่านข้อมูลของผู้ใช้ต้องกลับไป TU [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1237" width="1350" height="100" /></mxCell><mxCell id="flow-A8title" value="A8  /  Catalog" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1344" width="1350" height="32" /></mxCell><mxCell id="flow-A8body" value="HTTP API route ANY /fetchPartnersData เรียก Lambda fetchPartnersData [LIVE]. Lambda คืน JSON ที่คัดข้อมูลสาธารณะแล้ว → API → Amplify → browser ตาม A2/A1; เป็นคนละ code path กับ /api/public/records" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1380" width="1350" height="100" /></mxCell><mxCell id="flow-A9title" value="A9  /  Scan Partner" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1487" width="1350" height="32" /></mxCell><mxCell id="flow-A9body" value="fetchPartnersData ส่ง Scan ไป CSTUHub-Partner และอ่านหน้าต่อจนหมด; DynamoDB ส่ง rows กลับ แล้ว code กรอง publication/visibility, fields และความสัมพันธ์ก่อนตอบ [CODE]. ไม่ใช่ browser query ฐานข้อมูล" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1523" width="1350" height="100" /></mxCell><mxCell id="flow-L1title" value="L1  /  Legacy invoke" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1630" width="1350" height="32" /></mxCell><mxCell id="flow-L1body" value="เส้นทางที่ยังมีจริง: POST /login และ ANY /tuAuthLogin เรียก tuAuthLogin โดยตรง [LIVE], payload 2.0 / timeout 25 s. ไม่ผ่าน CSTUHubAuth; ยังไม่ได้ทดสอบ behavior ของ legacy routes รอบนี้" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1666" width="1350" height="100" /></mxCell><mxCell id="flow-U1title" value="U1  /  Upload / download" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1773" width="1350" height="32" /></mxCell><mxCell id="flow-U1body" value="Browser เรียกผ่าน A1–A3 เพื่อขอ upload ticket, complete/status หรือดาวน์โหลด. API ตรวจสิทธิ์ก่อนคืน signed POST อายุ 300 s, สถานะ ticket หรือ 302 ไป signed GET อายุ 120 s. ในเส้นนี้มีข้อมูลกำกับ ไม่ใช่ file upload bytes" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1809" width="1350" height="100" /></mxCell><mxCell id="flow-U2title" value="U2  /  Ticket / quota" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1916" width="1350" height="32" /></mxCell><mxCell id="flow-U2body" value="Auth ใช้ Business เก็บ ticket / attempt / lease / budget / owner และสถานะ รวมทั้งอ่าน state กลับ. Ticket อายุ 900 s; code default 20 tickets / 500 MiB ต่อผู้ใช้ต่อชั่วโมง. Completion ตรวจสิทธิ์ใหม่และกันคำขอซ้ำ [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="1952" width="1350" height="100" /></mxCell><mxCell id="flow-U3title" value="U3  /  POST / result" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2059" width="1350" height="32" /></mxCell><mxCell id="flow-U3body" value="Browser ส่งไฟล์จริงด้วย HTTPS multipart POST ไป S3 staging ตาม signed fields จาก U1; S3 ตอบผล HTTP กลับ. ไม่ส่ง cookie ของเว็บไป S3 และ upload สำเร็จยังไม่แปลว่าไฟล์พร้อมใช้งานในแอป" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2095" width="1350" height="100" /></mxCell><mxCell id="flow-U4title" value="U4  /  HEAD / GET" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2202" width="1350" height="32" /></mxCell><mxCell id="flow-U4body" value="Auth (ด้านขวา) ส่ง HEAD/GET กลับไป staging (ด้านซ้าย); S3 ส่ง bytes ของ VersionId ที่ล็อกไว้มาให้ตรวจขนาด, SHA-256, signature และโครงสร้าง DOCX แบบจำกัด. ตรวจชนิดไฟล์ไม่ใช่ antivirus [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2238" width="1350" height="100" /></mxCell><mxCell id="flow-U5title" value="U5  /  Copy / VersionId" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2345" width="1350" height="32" /></mxCell><mxCell id="flow-U5body" value="Auth ส่ง CopyObject ให้ S3 คัดลอกรุ่น staging ที่ตรวจแล้วไป key ใหม่ใต้ ready; S3 คืน VersionId ปลายทาง. เป็น server-side copy ภายใน S3 ไม่ใช่ S3 event trigger เรียก worker และไม่ใช่ bytes ผ่าน API Gateway [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2381" width="1350" height="100" /></mxCell><mxCell id="flow-U6title" value="U6  /  Async replication" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2488" width="1350" height="32" /></mxCell><mxCell id="flow-U6body" value="S3 ทำ replication แบบ asynchronous จาก ready → backup ด้วย role ของ S3. Rule CSTUHubReadyDocumentsBackup จำกัด documents/ready/, ปิด delete-marker replication และไม่มี RTC. เริ่มจาก object creation โดยไม่รอ U7; อาจมี orphan copy ได้" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2524" width="1350" height="100" /></mxCell><mxCell id="flow-U7title" value="U7  /  Commit" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2631" width="1350" height="32" /></mxCell><mxCell id="flow-U7body" value="หลัง copy, Auth ตรวจสิทธิ์/รายการหลักล่าสุดอีกครั้ง แล้ว transaction ลง Business: objectKey, storageVersionId, audience, size/hash และ ticket ready. ถ้า commit ไม่สำเร็จ ไฟล์ที่คัดลอกแล้วไม่ถือว่าเป็น attachment สำเร็จ [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2667" width="1350" height="100" /></mxCell><mxCell id="flow-U8title" value="U8  /  GET / bytes" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2774" width="1350" height="32" /></mxCell><mxCell id="flow-U8body" value="หลัง U1 อนุญาตดาวน์โหลด Browser ส่ง signed GET ไป S3 ready โดยระบุ VersionId; S3 คืนไฟล์ส่วนตัวตรงถึง browser พร้อม no-store. URL ที่ออกแล้วอาจใช้ได้จนหมดอายุ แม้เปลี่ยนสิทธิ์ในเว็บแล้ว [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2810" width="1350" height="100" /></mxCell><mxCell id="flow-M1title" value="M1  /  Metrics / logs" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2917" width="1350" height="32" /></mxCell><mxCell id="flow-M1body" value="CloudWatch รับ metrics จาก API/Lambda เพื่อประเมิน alarms; execution logs ของ Lambda เขียนด้วย execution role. ยังไม่ยืนยัน API access-log configuration และไม่อ้างว่าทุก request มี trace ครบทั้งระบบ" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="2953" width="1350" height="100" /></mxCell><mxCell id="flow-M2title" value="M2  /  ALARM / OK" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3060" width="1350" height="32" /></mxCell><mxCell id="flow-M2body" value="CloudWatch ส่ง state change ALARM/OK ไป SNS. ตรวจ actions enabled และ topic ปลายทางของ API-5xx กับ CSTUHubAuth-Errors แล้ว [AUDIT]; อีก 8 alarms ยังไม่ได้ยืนยัน actions ทีละตัว" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3096" width="1350" height="100" /></mxCell><mxCell id="flow-M3title" value="M3  /  Email" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3203" width="1350" height="32" /></mxCell><mxCell id="flow-M3body" value="SNS ส่งอีเมลให้ทีมผ่าน subscription ที่ Confirmed [AUDIT]. ทีมเป็นผู้วิเคราะห์และกู้ระบบ ไม่มี automatic failover จากลูกศรนี้; ยังไม่ได้ทดสอบการส่งอีเมลจริงในรอบนี้" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3239" width="1350" height="100" /></mxCell><mxCell id="flow-C1title" value="C1  /  Commit / build" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3346" width="1350" height="32" /></mxCell><mxCell id="flow-C1body" value="GitHub main ที่เชื่อมกับ Amplify ทำให้ build frontend และ publish public/; มีผล build/deploy กลับมาให้ดู. Console ล่าสุดแสดง deployed และ commit กล่าวถึง PR #207. งานนี้แยกจากการ deploy Lambda" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3382" width="1350" height="100" /></mxCell><mxCell id="flow-C2title" value="C2  /  OIDC / credentials" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3489" width="1350" height="32" /></mxCell><mxCell id="flow-C2body" value="GitHub Actions แลก OIDC token ผ่าน AWS STS เพื่อรับ temporary credentials ของ CSTUHubGitHubAuthDeployRole ตาม workflow [CODE]. IAM/STS เป็น control plane ไม่ใช่ทางผ่าน API requests ของเว็บ" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3525" width="1350" height="100" /></mxCell><mxCell id="flow-C3title" value="C3  /  Deploy / verify" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#215C72;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3632" width="1350" height="32" /></mxCell><mxCell id="flow-C3body" value="Actions ใช้สิทธิ์จาก C2 ส่ง ZIP ผ่าน UpdateFunctionCode ไป CSTUHubAuth แล้วอ่าน revision/code hash กลับ พร้อมขั้นตอนสำรองตาม deploy script [CODE]. ยังไม่ยืนยัน workflow run ล่าสุดหรือว่า Lambda อีก 3 ตัว deploy ตามอัตโนมัติ" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3668" width="1350" height="100" /></mxCell><mxCell id="apifamiliest" value="APP SURFACES BEHIND /api/* [CODE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3855" width="1350" height="32" /></mxCell><mxCell id="apifamiliesb" value="/auth/session, /auth/login, /auth/logout • /public/records&lt;br&gt;/partners, /activities, /agreements, /exchanges + contacts / history / feedback&lt;br&gt;/me/exchanges, document access, /overview, /selection-* และ /users/*/roles&lt;br&gt;Backend ใช้ role + scope + ownership / participation + parent record ทุกครั้งตามงาน&lt;br&gt;ต้องตรวจ deployed revision ก่อนอ้างสิทธิ์ feedback รายกรณีจาก source นี้" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="3893" width="1350" height="197" /></mxCell><mxCell id="prooft" value="EVIDENCE / PRESENTATION BOUNDARY" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="4115" width="1350" height="32" /></mxCell><mxCell id="proofb" value="[LIVE] คือการตั้งค่าที่ตรวจรอบนี้ ไม่ใช่ทดสอบทุก user flow.&lt;br&gt;[CODE] มาจาก local base 5be4a0b; frontend มีงานแก้ค้างอยู่ ไม่ได้ deploy ในงาน diagram.&lt;br&gt;ไม่ทดสอบโหลด ไม่แก้ AWS ไม่สร้างข้อมูลจริง ไม่อ้าง RTO/RPO ที่ยังไม่วัด.&lt;br&gt;โปรดซูมภาพ หรือเปิดไฟล์ .drawio เพื่อแก้ข้อความและติดตามแต่ละเส้น." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=18;fontColor=#26374B;fontStyle=0;" vertex="1" parent="flowlegend"><mxGeometry as="geometry" x="40" y="4153" width="1350" height="182" /></mxCell></root></mxGraphModel></diagram></mxfile>