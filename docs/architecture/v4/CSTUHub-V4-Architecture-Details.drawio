        <mxCell id="monlimitst" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=3;fontFamily=Arial;fontSize=20;fontColor=#26374B;fontStyle=1;" value="OBSERVABILITY LIMITS" vertex="1">
